APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap transactional Email API (production).
# railsware/mailtrap-php is in composer.json so the `mailtrap` transport is
# always registered. Set:
#   MAIL_MAILER=mailtrap
#   MAILTRAP_HOST=send.api.mailtrap.io
#   MAILTRAP_API_KEY=<from Mailtrap dashboard → Email Sending → API tokens>
# Token: Mailtrap dashboard → Email Sending → API tokens.
# Note: Mailtrap's SANDBOX SMTP (sandbox.smtp.mailtrap.io) is dev-only and
# unreachable from cloud IPs (Railway, Render, AWS, etc). Use the Email API
# (`MAILTRAP_HOST=send.api.mailtrap.io`) in production. See docs/MAIL_SETUP.md.

# Invitations + PayMongo receipts are sent via the above MAIL_* config.
# See docs/MEMBERS.md and docs/PAYMONGO_SETUP.md.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=test
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SUCCESS_URL=https://your-app.example.test/billing/return/success
PAYMONGO_CANCEL_URL=https://your-app.example.test/billing/return/cancel
PAYMONGO_TRIAL_DAYS=14

# Sentry (optional). Leave blank in local dev to disable.
# See docs/OBSERVABILITY.md for setup.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ERRORS_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# AI layer (AIManager + agents + memory). See docs/AI_SETUP.md.
# Provider: openai | ollama | fake
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT=30
# Ollama runs locally only. Set AI_PROVIDER=ollama for dev.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=60
# Cost guards (USD cents).
AI_DAILY_COST_CAP_CENTS=50
AI_COST_PROMPT_CENTS=0.015
AI_COST_COMPLETION_CENTS=0.06
# Per-agent cost caps.
AI_AGENT_FOUNDER_COST_CAP_CENTS=10
AI_AGENT_SALES_COST_CAP_CENTS=5
AI_AGENT_SUPPORT_COST_CAP_CENTS=15
AI_AGENT_CS_COST_CAP_CENTS=10
# Support agent falls back to a ticket when KB similarity is below this.
AI_AGENT_SUPPORT_RAG_THRESHOLD=0.55
# Customer success escalates customers with score >= this.
AI_AGENT_CS_ESCALATION_SCORE=70
# Memory + notifications.
AI_MEMORY_DRIVER=eloquent
AI_EMBEDDING_DIMENSIONS=1536
AI_FOUNDER_EMAIL=
AI_FAILURE_ALERT_EMAIL=
AI_TIMEZONE=Asia/Manila
