# Production environment template.
#
# This file is REFERENCE ONLY — never commit real secrets. Copy to .env on the
# host (Railway Variables tab, Render envVars, or your own server) and fill in.
# The repo's `.env.example` stays as the default (SQLite + log mailer) so a
# fresh clone still boots locally without any cloud creds.
#
# See docs/RAILWAY_DEPLOY.md for the full deployment walkthrough.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="BarangayBooks"
APP_ENV=production
APP_KEY=                              # php artisan key:generate --show
APP_DEBUG=false                       # MUST be false in production
APP_TIMEZONE=Asia/Manila              # PH deployments should override UTC
APP_URL=https://your-domain.tld
# IMPORTANT: APP_URL must be https:// for form actions, email links, and signed
# URLs to be generated with the correct scheme. On Railway, you can use either
# the auto-generated domain (https://<service>.up.railway.app) or your custom
# domain. Using http:// here causes browser warnings like "form is not secure"
# and breaks email verification links.

# `bootstrap/app.php` also calls $middleware->trustProxies(at: '*') so the
# in-request URL helper honors Railway's X-Forwarded-Proto header. Without it,
# `url()` would generate http:// links even though the user is on https://.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                       # quiet in prod; debug only locally

# ---------------------------------------------------------------------------
# Database (MySQL on Railway/Render; SQLite only for tests)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / cache / queue — database drivers require migrate --force to have run
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3                    # receipts on Backblaze B2 (S3-compatible)
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# MAIL_MAILER options:
#   - mailtrap: Mailtrap transactional Email API (HTTP, works from any IP).
#               RECOMMENDED for Railway/Render/cloud deploys.
#               Requires: symfony/mailtrap-mailer (already in composer.json).
#               See docs/MAIL_SETUP.md §"Option A".
#   - smtp:     generic SMTP (Postmark, Mailgun, SES, SendGrid, etc.).
#               Do NOT point at sandbox.smtp.mailtrap.io from production —
#               it is dev-only and unreachable from cloud IPs.
#   - log:      writes rendered emails to storage/logs/laravel.log. No SMTP.
#               Use this for staging or to unblock deploys while you wire up
#               a real provider. Tail the log to read emails.
#   - sendmail: local sendmail binary (not available on Railway).
MAIL_MAILER=mailtrap
# Mailtrap Email API (production). Get a token from
# Mailtrap dashboard → Email Sending → Sending Domains → your domain → API tokens.
# Scheme: mailtrap+api = live transactional; mailtrap+sandbox = sandbox inbox;
#         mailtrap+smtp  = SMTP relay (rarely used; the API is recommended).
MAIL_MAILTRAP_DSN=mailtrap+api://YOUR_TOKEN@default
MAIL_FROM_ADDRESS="hello@your-domain.tld"
MAIL_FROM_NAME="${APP_NAME}"

# Generic SMTP (if you go that route instead):
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# To unblock deploys while wiring email:
#   MAIL_MAILER=log
# Then read rendered emails via:
#   railway run tail -f storage/logs/laravel.log

# ---------------------------------------------------------------------------
# Backblaze B2 (S3-compatible) — contribution photo storage
# ---------------------------------------------------------------------------
# Application Key MUST have listFiles/readFiles/writeFiles/deleteFiles and be
# scoped to AWS_BUCKET. A key scoped to another bucket returns "not entitled".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-005
AWS_BUCKET=householdsaas-bucket
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENABLE_THROW=true                  # surface S3 errors instead of silently returning null

# ---------------------------------------------------------------------------
# Vite (informational; baked at build time by `npm run build`)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PayMongo billing
# ---------------------------------------------------------------------------
PAYMONGO_SECRET_KEY=                    # sk_live_... (server-side only — never expose)
PAYMONGO_PUBLIC_KEY=                    # pk_live_... (optional, only for client-side flows)
PAYMONGO_WEBHOOK_SECRET=                # REQUIRED for /billing/webhook HMAC verification
PAYMONGO_MODE=live
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SUCCESS_URL="${APP_URL}/billing/return/success"
PAYMONGO_CANCEL_URL="${APP_URL}/billing/return/cancel"
PAYMONGO_TRIAL_DAYS=14

# See docs/PAYMONGO_SETUP.md for the full walkthrough (dashboard setup,
# webhook URL registration, signature algorithm, secret rotation).

# ---------------------------------------------------------------------------
# Sentry (errors + performance)
# ---------------------------------------------------------------------------
# DSN from sentry.io → Settings → Projects → Client Keys (DSN).
# Optional — app runs without it, errors just go to the laravel.log file.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=                              # Optional: git SHA or deploy tag for release tracking
SENTRY_ERRORS_SAMPLE_RATE=1.0                # 0.0-1.0; 1.0 = report every error
SENTRY_TRACES_SAMPLE_RATE=0.2                # 0.0-1.0; performance transaction sample rate
SENTRY_PROFILES_SAMPLE_RATE=0.2              # 0.0-1.0; profiling sample rate within traced txns

# See docs/OBSERVABILITY.md for setup + PII scrubbing notes.
