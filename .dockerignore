# Keep the build context small — Nixpacks/Render/Docker all read this.
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*
/vendor
/.git
/.git/objects
/.git/refs
/.idea
/.vscode
/.fleet
/.phpunit.cache
/.phpunit.result.cache
/.env
/.env.backup
/.env.production
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/docs/superpowers/plans